# انسخ هذا الملف إلى .env للتشغيل المحلي (لا تحتاجه على Railway، فقط اضبط نفس المتغيرات من لوحة Railway)

# يوفرها Railway تلقائياً عند إضافة Postgres Plugin — للتشغيل المحلي اضبطها يدوياً
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forecast_system

# مفتاح سري لتوقيع جلسات الدخول (JWT) — ولّد قيمة عشوائية طويلة وثابتة، لا تشاركها
JWT_SECRET=change-this-to-a-long-random-secret

# بيانات أول حساب Admin يُنشأ تلقائياً عند أول تشغيل (فقط إذا لم يوجد أي مستخدم بعد)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password

PORT=3000
NODE_ENV=production
